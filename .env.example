# ==============================================================================
# Partnerizt Environment Variables & API Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vision & LLM Model Configuration (Google Gemini / Gemma)
# ------------------------------------------------------------------------------
# Google Gemini API (Recommended & Free at: https://aistudio.google.com/app/apikey)
GEMMA_API_KEY=your_gemini_gemma_api_key_here
GEMMA_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it
# ------------------------------------------------------------------------------
# 2. SerpApi Web Knowledge Search (https://serpapi.com/)
# ------------------------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_api_key_here

# ------------------------------------------------------------------------------
# 3. ElevenLabs Text-to-Speech (https://elevenlabs.io/)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 3. Database (Defaults to embedded H2 in-memory if PostgreSQL is not running)
# ------------------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/partnerizt_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 4. Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1
